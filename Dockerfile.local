FROM python:3.12-slim
WORKDIR /lab
ENV PYTHONUNBUFFERED=1 PYTHONIOENCODING=utf-8 HF_HOME=/cache/huggingface-day21
COPY requirements-local-gpu.txt /tmp/requirements-local-gpu.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements-local-gpu.txt
COPY . /lab
CMD ["python", "scripts/verify.py", "--smoke"]
